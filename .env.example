DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Optional TURN Server Configuration (supports Coturn, Metered, Twilio, etc.)
# If omitted, Pulse defaults to resilient public STUN servers.
# TURN_URLS="turn:turn.yourdomain.com:3478?transport=udp,turns:turn.yourdomain.com:5349?transport=tcp"
#
# Option A: Ephemeral time-limited credentials (RFC 5766 coturn REST API)
# TURN_SECRET="your_shared_turn_secret_token"
#
# Option B: Static credentials
# TURN_USERNAME="pulse-turn-user"
# TURN_CREDENTIAL="your-turn-password"


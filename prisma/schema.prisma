// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id             String         @id // server-generated public session uuid
  tokenHash      String? // SHA-256 of the private session token; nullable only for pre-migration rows
  lat            Float // ALREADY privacy-offset coords (raw is never stored)
  lng            Float
  intent         String // temporary allowlisted conversation intent
  language       String         @default("en") // temporary allowlisted conversation language
  busy           Boolean        @default(false) // true while in an active connection
  lastSeen       DateTime
  thanksGivenAt  DateTime? // temporary anti-abuse marker; deleted with the session
  blocksCreated  SessionBlock[] @relation("Blocker")
  blocksReceived SessionBlock[] @relation("Blocked")

  @@index([lastSeen])
}

model SessionBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   Presence @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Presence @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model SafetyReport {
  id                String   @id @default(uuid())
  reporterSessionId String
  reportedSessionId String
  reason            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@unique([reporterSessionId, reportedSessionId])
  @@index([reportedSessionId])
  @@index([expiresAt])
}

model CommunityPulseDaily {
  day          String   @id // UTC date (YYYY-MM-DD); aggregate only
  feltHeard    Int      @default(0)
  helped       Int      @default(0)
  madeSmile    Int      @default(0)
  goodListener Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
  @@index([fromId])
  @@index([createdAt])
}
